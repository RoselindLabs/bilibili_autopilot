{
  "schema_version": 2,
  "required_capabilities": ["custom_pages"],
  "workspace_title": "B站手记",
  "pages": [{
    "id": "manage", "title": "B站手记", "description": "随刷随记，回看每天留下的感想。",
    "placement": "sidebar", "icon": "list", "mode": "custom", "entry": "journal.html", "layout": "document",
    "queries": {
      "prepare_delete": {"api": "prepare_journal_delete", "parameters": {
        "ids": {"type": "string", "max_length": 6600},
        "failed": {"type": "boolean"}
      }},
      "overview": {"api": "autopilot_overview", "parameters": {}},
      "journal": {"api": "reading_journal", "parameters": {
        "day": {"type": "string", "max_length": 10},
        "before": {"type": "string", "max_length": 32},
        "query": {"type": "string", "max_length": 200}
      }},
      "records": {"api": "autopilot_records", "parameters": {
        "kind": {"type": "string", "choices": ["visits", "attempts", "decisions", "replies", "reply_attempts", "shares"]},
        "search": {"type": "string", "max_length": 200},
        "page": {"type": "integer", "minimum": 1}
      }}
    },
    "actions": {
      "delete_journal": {"api": "delete_journal", "parameters": {
        "token": {"type": "string", "required": true, "max_length": 32}
      }, "confirmation": "永久删除刚才确认的手记内容和待分享素材？此操作无法撤销。"},
      "command": {"api": "autopilot_command", "parameters": {
        "command": {"type": "string", "required": true, "choices": ["/bili_auto start", "/bili_auto pause", "/bili_auto login", "/bili_auto status", "/bili_auto preview", "/bili_auto replies"]}
      }},
      "logout": {"api": "autopilot_logout", "parameters": {}, "confirmation": "退出当前B站账号并暂停浏览？手记和历史会保留。"},
      "ack": {"api": "autopilot_ack", "parameters": {
        "bvid": {"type": "string", "required": true, "max_length": 12}
      }, "confirmation": "确认已在B站核对这条发送结果？解除阻塞后也不会重发。"}
    }
  }]
}
