{
  "manifest_version": 2,
  "id": "local.bilibili-autopilot",
  "name": "Neko B站手记",
  "version": "0.13.1",
  "description": "随刷随记，保存独立感想与前后关联，按天回看阅读经历，偶尔在已授权群聊或私聊中自然分享。",
  "author": {
    "name": "sakura桜花",
    "url": "https://github.com/namchengwuqiu"
  },
  "urls": {
    "repository": "https://github.com/RoselindLabs/bilibili_autopilot",
    "homepage": "https://github.com/RoselindLabs/bilibili_autopilot",
    "documentation": "https://github.com/RoselindLabs/bilibili_autopilot#readme",
    "issues": "https://github.com/RoselindLabs/bilibili_autopilot/issues"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.19",
    "max_version": "1.3.19"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "bilibili-api-python",
      "version_spec": "==17.4.2"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27,<1"
    },
    {
      "type": "python_package",
      "name": "qrcode",
      "version_spec": ">=8,<9"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10"
    }
  ],
  "capabilities": [
    "llm.generate",
    "config.get",
    "send.text",
    "send.image",
    "chat.get_group_streams",
    "chat.get_private_streams"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "local",
      "value": "icon.png",
      "fallback": "play",
      "background": "#E7F9FF"
    }
  }
}
